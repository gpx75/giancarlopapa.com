# All custom env vars use the Nuxt NUXT_ prefix convention so they
# auto-bind to runtimeConfig. See nuxt.config.ts for the full mapping.

# Cal.com
NUXT_CAL_API_KEY=
NUXT_CAL_USERNAME=
NUXT_CAL_BASE_URL=https://api.cal.com

# Site
NUXT_PUBLIC_SITE_URL=https://giancarlopapa.com
NUXT_CONTACT_EMAIL=contact@giancarlopapa.com

# Resend (email)
NUXT_RESEND_API_KEY=
NUXT_RESEND_TO_EMAIL=

# Auth session (generate with: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: http://localhost:3000/auth/github (dev) | https://giancarlopapa.com/auth/github (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/auth/google (dev) | https://giancarlopapa.com/auth/google (prod)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth — https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect"
# Callback URL: http://localhost:3000/auth/linkedin (dev) | https://giancarlopapa.com/auth/linkedin (prod)
NUXT_OAUTH_LINKEDIN_CLIENT_ID=
NUXT_OAUTH_LINKEDIN_CLIENT_SECRET=

# Strava (activity feed)
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=
NUXT_STRAVA_REFRESH_TOKEN=

# Gmail IMAP (admin inbox sync)
# Cloudflare Email Routing forwards *@giancarlopapa.com → this Gmail
# inbox. The admin dashboard connects to imap.gmail.com and filters
# server-side via X-GM-RAW for 'to:@giancarlopapa.com newer_than:1y'.
# App password — requires 2FA on the Google account:
#   https://myaccount.google.com/apppasswords
NUXT_GMAIL_USER=
NUXT_GMAIL_APP_PASSWORD=

# Anthropic (AI match analysis + cover letter generation)
NUXT_ANTHROPIC_API_KEY=

# RapidAPI (JSearch job search — LinkedIn, Indeed, Glassdoor)
# Get a free key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
NUXT_RAPID_API_KEY=

# Supabase — Vercel's Supabase integration auto-injects these at runtime.
# @nuxtjs/supabase reads them via `supabase: { url, key, serviceKey }` in
# nuxt.config.ts. For local dev, run `vercel env pull` to sync.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PDF generation (Puppeteer)
# Local dev: point to your Chrome. On Vercel, leave unset — Chromium downloads at runtime.
CHROMIUM_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
